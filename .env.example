STT_PROFILE=standard
STT_MODEL=small
# Kosongkan untuk deteksi otomatis. Gunakan id hanya bila semua percakapan berbahasa Indonesia.
STT_LANGUAGE=
STT_COMPUTE_TYPE=int8
STT_AUDIO_SAMPLE_RATE=48000
STT_AUDIO_BLOCKSIZE=960

# Editor bahasa masih dimatikan pada profil standard.
# Saat perangkat ditingkatkan: LLM_ENABLED=true, LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
LLM_ENABLED=false
LLM_MODEL=
